{
  "name": "corelata-web",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.8",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "gen:api": "openapi-typescript ../schema/openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "fmt": "prettier --write . && eslint --fix .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@tanstack/react-query": "5.108.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
